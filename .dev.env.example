ITS_PASSWORD=
# Educational platform directory on the OLD 1C server (contains bin\1cv8t.exe).
# Not installed on vdswin2k22 / the Cursor machine.
PLATFORM_PATH=
# file -> Designer /F ; server -> Designer /S
INFOBASE_KIND=
# File IB path or server connection string on the OLD 1C server. Do not invent a path.
INFOBASE_PATH=
IB_USER=
IB_PASSWORD=
INFOSTART_LOGIN=
INFOSTART_PASSWORD=
JAVA_HOME=
PYTHON=
# SSH Host alias on vdswin2k22 (e.g. 1c-erp). Private keys stay in %USERPROFILE%\.ssh — never in git.
REMOTE_SSH_HOST=
# Phase 2 web-publish URL of the test IB. Empty = UI tests skipped.
INFOBASE_PUBLISH_URL=
# Directory for /DumpConfigToFiles and /LoadConfigFromFiles. Empty = repository root (local runner).
EXPORT_PATH=
